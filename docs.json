            "icon": "settings"
          },
          {
            "group": "Team & audit",
            "pages": [
              "admin/users-and-roles",
              "admin/media-library",
              "admin/seeder-library",
              "admin/activity-log"
            ],
            "icon": "users"
          },
          {
            "group": "AI Flow",
            "pages": [
              "admin/ai-node-catalog",
              "admin/ai-flow-exemplars",
              "admin/ai-generations"
            ],
            "icon": "workflow"
          }
        ]
      },
      {
        "tab": "API",
        "openapi": "/api-collection/openapi.json",
        "pages": [
          "api/overview",
          {
            "group": "Plans",
            "icon": "layers",
            "pages": [
              "GET /api/v1/plans",
              "GET /api/v1/plans/{id}"
            ]
          }
        ]
      }
    ]
