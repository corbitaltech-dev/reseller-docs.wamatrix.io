            "icon": "rocket"
          },
          {
            "group": "Sales",
            "pages": [
              "admin/subscriptions",
              "admin/invoices-and-payments",
              "admin/offline-payments",
              "admin/coupons",
              "admin/taxes"
            ],
            "icon": "shopping-cart"
          },
          {
            "group": "Customers",
            "pages": [
              "admin/managing-customers",
              "admin/plan-limits-and-customer-access"
            ],
            "icon": "building-2"
          },
          {
            "group": "Settings",
            "pages": [
              "admin/core-platform",
              "admin/infrastructure-and-security",
              "admin/channels",
              "admin/tech-provider-approval",
              "admin/messenger-permissions"
